# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase browser/server configuration.
# IMPORTANT for local Docker development:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY must be the SAME JWT as ANON_KEY below.
#   SUPABASE_SERVICE_ROLE_KEY must be the SAME JWT as SERVICE_ROLE_KEY below.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-same-value-as-anon-key-below
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-same-value-as-service-role-key-below

# Private traveler-document bucket (Supabase Storage). Keep this bucket private.
DOCUMENTS_BUCKET=travel-documents

# Generic website/custom-app lead webhook. Generate a long random value; never expose it in NEXT_PUBLIC_*.
LEADS_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# OAuth tokens, Chatwoot webhook secrets and workspace BYOK AI provider keys are encrypted before storage.
# Generate a 32-byte key as 64 hex characters, for example:
#   openssl rand -hex 32
INTEGRATION_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional previous key used only during encryption-key rotation.
# INTEGRATION_TOKEN_ENCRYPTION_KEY_PREVIOUS=replace-with-previous-64-hex-key

# Optional dedicated shared-inbox email ingestion secret. Falls back to LEADS_WEBHOOK_SECRET when omitted.
EMAIL_INGEST_SECRET=replace-with-at-least-32-random-characters

# Redis operational layer. Postgres remains the source of truth.
# Host-run Next.js uses localhost; the Docker app overrides this to redis://redis:6379.
REDIS_URL=redis://127.0.0.1:6379
REDIS_PORT=6379
# Secret used only between the integration worker and the CRM worker endpoint.
INTEGRATION_SYNC_SECRET=replace-with-a-different-32-character-random-secret
INTEGRATION_SYNC_INTERVAL_SECONDS=3

# Internal base URL used by Docker cron/worker containers to call the CRM app.
# Full Docker/Coolify deployment should use the Compose service name (the default below).
# If Next.js runs directly on the host while workers run in Docker, override this in docker/.env:
#   CRM_INTERNAL_URL=http://host.docker.internal:3000
CRM_INTERNAL_URL=http://app:3000

# Chatwoot omnichannel conversation engine.
# Local setup helper:
#   npm run setup:chatwoot
# Keep these server-only. The CRM maps one Chatwoot Account to each CRM workspace.
# Configure each Chatwoot account webhook URL as:
#   <APP_URL>/api/integrations/webhooks/chatwoot
# Its signing secret is entered through the CRM Chatwoot setup flow and stored encrypted per workspace.
CHATWOOT_BASE_URL=http://localhost:3001
CHATWOOT_API_ACCESS_TOKEN=replace-with-chatwoot-personal-access-token
# Reject webhook signatures older/newer than this replay window (seconds).
CHATWOOT_WEBHOOK_MAX_AGE_SECONDS=300

# AI workspace agents use encrypted BYOK provider connections configured in Settings > AI Providers.
# MISTRAL_API_KEY is optional and retained only as a legacy server-level fallback for existing agents.
MISTRAL_API_KEY=
# Custom provider URLs must use public HTTPS by default. Enable this only on a trusted deployment
# when intentionally connecting to Ollama/vLLM/LocalAI or another provider on a private network.
AI_ALLOW_PRIVATE_PROVIDER_NETWORKS=false

# Meta: Facebook Lead Ads, Messenger, Instagram Business and WhatsApp Business.
# Create one Meta developer app, add the required products, and register:
#   OAuth redirects: <APP_URL>/api/integrations/oauth/{facebook|instagram|whatsapp}/callback
#   Webhook callback: <APP_URL>/api/integrations/webhooks/meta
# META_GRAPH_VERSION defaults to v26.0 when omitted.
# ads_read is required by the CRM for automatic ad/campaign/ad-set enrichment and is
# appended automatically even when a custom META_*_SCOPES override is configured.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-verification-token
# Optional overrides when your reviewed Meta app uses a different approved scope set.
# Existing values are preserved and ads_read is added automatically by the application.
# META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,pages_messaging,leads_retrieval,business_management,ads_read
# META_INSTAGRAM_SCOPES=pages_show_list,pages_read_engagement,pages_manage_metadata,instagram_basic,instagram_manage_messages,business_management,ads_read
# META_WHATSAPP_SCOPES=business_management,whatsapp_business_management,whatsapp_business_messaging,ads_read

# Self-hosted WhatsApp linked-device bridge (Baileys).
# Generate two different random secrets, for example: openssl rand -hex 32
# Local Next.js defaults to http://127.0.0.1:3101; Docker app uses the internal service URL.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3101
WHATSAPP_BRIDGE_API_KEY=replace-with-a-different-32-character-random-secret
WHATSAPP_BRIDGE_WEBHOOK_SECRET=replace-with-another-32-character-random-secret
WHATSAPP_BRIDGE_PORT=3101
# When running Next.js on the host while the bridge runs in Docker, override this in docker/.env:
# WHATSAPP_BRIDGE_CRM_WEBHOOK_URL=http://host.docker.internal:3000/api/integrations/webhooks/whatsapp-baileys

# TikTok API for Business: OAuth + Lead Generation webhook.
# OAuth redirect: <APP_URL>/api/integrations/oauth/tiktok/callback
# Webhook callback: <APP_URL>/api/integrations/webhooks/tiktok
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Server-side SLA/follow-up worker. Use a different long random value.
SLA_CRON_SECRET=replace-with-a-different-32-character-random-secret
SLA_INTERVAL_SECONDS=60

# Self-hosted Supabase / Docker
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
ANON_KEY=replace-with-signed-anon-jwt
SERVICE_ROLE_KEY=replace-with-signed-service-role-jwt

# Realtime has separate encryption secrets. SECRET_KEY_BASE must be at least
# 64 characters. REALTIME_DB_ENC_KEY must be exactly 16 characters.
SECRET_KEY_BASE=replace-with-at-least-64-random-characters-for-realtime
REALTIME_DB_ENC_KEY=change-me-16char

PUBLIC_SUPABASE_URL=http://localhost:8000
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/**
GOTRUE_DISABLE_SIGNUP=true

# Development only. Keep false/unset in production.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false