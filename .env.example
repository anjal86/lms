# ==========================================
# Wanderlust CRM — Environment Configuration
# ==========================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public API (Frontend + Edge)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (Server-side & Webhooks only - NEVER expose in client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Inbound Leads Webhook Secret
LEADS_WEBHOOK_SECRET=your-secure-webhook-secret-token

# Optional: Upstash Redis for API Rate Limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
