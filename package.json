{
  "name": "travel-leads-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "e2e:install": "npm install --no-save @playwright/test@1.55.0 && npx playwright install chromium",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "doctor:local": "node scripts/doctor-local.mjs",
    "keys:local": "node scripts/generate-local-supabase-secrets.mjs --write",
    "db:migrate:local": "node scripts/apply-local-migrations.mjs && node scripts/apply-local-migration-038.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "seed:users": "node scripts/seed-users.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.45.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.453.0",
    "papaparse": "^5.5.3",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
